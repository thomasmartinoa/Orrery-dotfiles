#!/usr/bin/env python3
"""orrery-menu-data — dynamic rows and live state for the shell's menu, as one JSON
object, in one process (the menu runs it every time it opens).

  {
    "state":  { "nightlight": true, "gaps": true, "opacity": true, "hibernate": true,
                "terminal": "kitty", "browser": "zen-browser", "agent": "claude" },
    "agents":      [ {id, label, icon, action, checked} ],
    "keybindings": [ {id, label, value, description} ],
    "fonts":       [ {id, label, checked, action, keep} ],
    "reminders":   [ {id, label} ],
    "webapps":     [ {id, label, value, icon, action} ]    (and "webapps.remove")
    "about":       [ {id, label, value} ]
  }
"""
import json, os, re, shutil, subprocess, sys, time

HOME = os.path.expanduser("~")
# the clone, wherever it is: ~/.config/orrery links to <repo>/theme/.config/orrery
REPO = os.path.realpath(os.path.join(HOME, ".config", "orrery", "..", "..", ".."))


def sh(cmd, timeout=3):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except Exception:
        return ""


def read(path, default=""):
    try:
        return open(path).read().strip()
    except OSError:
        return default


def state():
    gaps = sh("hyprctl getoption general:gaps_in -j")
    opac = sh("hyprctl getoption decoration:active_opacity -j")
    try:
        gaps_on = json.loads(gaps).get("css", "") != "0 0 0 0"
    except Exception:
        gaps_on = True
    try:
        opac_on = json.loads(opac).get("float", 1.0) < 0.999
    except Exception:
        opac_on = True
    hib = "disk" in read("/sys/power/state") and bool(sh("swapon --show --noheadings"))
    # corners and border (orrery-border); absent = the defaults, 4 and 1
    try:
        look = json.load(open(f"{HOME}/.config/orrery/shell.json")).get("look", {})
    except Exception:
        look = {}
    radius, border = str(look.get("radius", 4)), str(look.get("border", 1))
    # blur and window transparency (orrery-look); absent = medium blur, 90 %
    blur_on = look.get("blur", True) is not False
    size = look.get("blurSize", 8)
    blur_level = {4: "light", 8: "medium", 14: "strong"}.get(size, str(size))
    opacity = str(look.get("opacity", 90))
    return {
        "nightlight": bool(sh("pgrep -x hyprsunset")),
        "gaps": gaps_on, "opacity": opac_on, "hibernate": hib,
        "terminal": read(f"{HOME}/.config/orrery/defaults/terminal", "kitty"),
        "browser": read(f"{HOME}/.config/orrery/defaults/browser", "zen-browser"),
        "agent": sh("orrery-agent default"),
        "font": sh("orrery-font").replace(" (default)", ""),
        "textsize": sh("orrery-text-size").splitlines()[0].split(":")[1].strip().split()[0] if shutil.which("orrery-text-size") else "12",
        "scale": (sh("hyprctl monitors -j | jq -r '.[] | select(.focused) | .scale'") or "").rstrip("0").rstrip(".") or "1",
        "wallpaper": os.path.basename(os.path.realpath(f"{HOME}/.config/orrery/current/background")),
        "radius": radius, "border": border,
        "blur": blur_on, "blurLevel": blur_level, "opacityLevel": opacity,
        "blurLabel": blur_level.capitalize() if blur_on else "Off",
        "opacityLabel": "Opaque" if opacity == "100" else f"{opacity}%",
        "glassLabel": ("Blur " + blur_level if blur_on else "No blur") + " · " + ("opaque" if opacity == "100" else f"{opacity}%"),
        # web apps: which browsers are installed (Add › In Firefox / In Chromium)
        "hasfirefox": bool(shutil.which("firefox")),
        "haschromium": any(shutil.which(b) for b in ("chromium", "google-chrome-stable", "google-chrome", "brave", "brave-browser", "vivaldi-stable", "vivaldi", "microsoft-edge-stable")),
        "radiusLabel": "square" if radius == "0" else f"{radius} px",
        "borderLabel": "none" if border == "0" else f"{border} px",
        "shape": ("square" if radius == "0" else f"{radius} px") + " · " + ("no border" if border == "0" else f"{border} px border"),
    }


# brand logos: Material Symbols has none, so these stay Nerd Font glyphs
AGENT_ICONS = {"claude": "󰛄", "codex": "", "opencode": "", "gemini": "󰊭", "copilot": ""}


def agents(default):
    out = []
    for line in sh("orrery-agent list").splitlines():
        m = re.match(r"[* ] +(\S+)\s+(.*?)(?: \(default\))?$", line)
        if not m:
            continue
        cmd, label = m.group(1), m.group(2)
        out.append({"id": cmd, "label": label, "icon": AGENT_ICONS.get(cmd, "󰚩"),
                    "action": f"orrery-agent launch {cmd}", "checked": cmd == default})
    return out


def keybindings():
    """Rows from modules/binds.lua: key, the trailing `-- comment` (or what it runs)."""
    src = read(f"{REPO}/hyprland/.config/hypr/modules/binds.lua")
    rows, i = [], 0
    while True:
        i = src.find("hl.bind(", i)
        if i < 0:
            break
        # skip a commented-out bind
        ls = src.rfind("\n", 0, i) + 1
        if src[ls:i].lstrip().startswith("--"):
            i += 8; continue
        # balance parentheses to find the call's end
        depth, j = 0, i + 7
        while j < len(src):
            if src[j] == "(": depth += 1
            elif src[j] == ")":
                depth -= 1
                if depth == 0: break
            j += 1
        args = src[i + 8:j]
        le = src.find("\n", j)
        tail = src[j + 1:le if le > 0 else None]
        cm = re.search(r"--\s*(.*)$", tail)
        m = re.match(r'\s*(mainMod\s*\.\.\s*)?"([^"]+)"', args)
        if not m:
            i = j; continue
        key = ("SUPER" + m.group(2)) if m.group(1) else m.group(2)
        if key.endswith("+ "):          # the workspace loop: `" + " .. key` — listed by hand below
            i = j; continue
        if cm:
            label = cm.group(1).strip()
        else:
            w = re.search(r'exec_cmd\(\s*(?:"|\[\[)?([^"\]\n]+)', args)
            label = (w.group(1) if w else re.sub(r"^\s*[^,]+,\s*", "", args)).strip()
            label = re.sub(r"^~/.config/hypr/scripts/", "", label).replace("hl.dsp.", "")
        rows.append({"id": key, "label": label[:60], "value": key.replace(" + ", "+"), "description": args[:80], "icon": "keyboard"})
        i = j
    rows += [{"id": "ws", "label": "Switch to workspace N (SHIFT: move window there)", "value": "SUPER+1…0", "description": "workspace"}]
    return rows


def fonts():
    cur = sh("orrery-font")
    out = []
    for f in sh("orrery-font list", timeout=6).splitlines():
        f = f.strip()
        if not f:
            continue
        out.append({"id": f, "label": f, "icon": "font_download", "checked": f == cur,
                    "action": "orrery-font set " + json.dumps(f), "keep": True})
    return out


def webapps():
    """Your web apps (orrery-webapp): open rows, and remove rows."""
    try:
        apps = json.loads(sh("orrery-webapp list --json") or "[]")
    except Exception:
        apps = []
    q = lambda v: "'" + v.replace("'", "'\\''") + "'"
    opened = [{"id": a["id"], "label": a["name"], "value": a.get("browser", "firefox").capitalize(),
               "icon": "language", "action": "orrery-webapp launch " + q(a["url"]) + " " + q(a["id"])} for a in apps]
    removed = [{"id": a["id"], "label": a["name"], "icon": "delete",
                "action": "orrery-webapp remove " + q(a["name"]), "keep": True} for a in apps]
    none = [{"id": "none", "label": "No web apps yet", "icon": "language"}]
    return opened or none, removed or none


def reminders():
    out = []
    for line in sh("orrery-remind show").splitlines():
        out.append({"id": line, "label": line, "icon": "alarm"})
    return out or [{"id": "none", "label": "No reminders", "icon": "alarm_off"}]


def about():
    commit = sh(f"git -C {REPO} log -1 --format='%h  %s'")
    branch = sh(f"git -C {REPO} rev-parse --abbrev-ref HEAD")
    up = sh("uptime -p").replace("up ", "")
    return [
        {"id": "rice", "label": "Orrery", "value": f"{branch} · {commit[:40]}", "icon": "auto_awesome"},
        {"id": "theme", "label": "Theme", "value": sh("orrery-theme current"), "icon": "palette"},
        {"id": "host", "label": "Machine", "value": f"{os.environ.get('USER','')}@{read('/etc/hostname')}", "icon": "computer"},
        {"id": "kernel", "label": "Kernel", "value": sh("uname -r"), "icon": "terminal"},
        {"id": "hypr", "label": "Hyprland", "value": sh("hyprctl version -j | jq -r .tag"), "icon": "desktop_windows"},
        {"id": "qs", "label": "Quickshell", "value": re.sub(r" *\(.*", "", sh("qs --version")).replace("quickshell ", ""), "icon": "code"},
        {"id": "uptime", "label": "Uptime", "value": up, "icon": "schedule"},
    ]


def main():
    st = state()
    print(json.dumps({"state": st, "agents": agents(st["agent"]), "keybindings": keybindings(), "fonts": fonts(),
                      "reminders": reminders(), "about": about(),
                      "webapps": webapps()[0], "webapps.remove": webapps()[1]}))


if __name__ == "__main__":
    main()
