#!/usr/bin/env bash
# orrery-theme — theme engine for Orrery.
#
#   orrery-theme set <name>     render a theme and apply it everywhere
#   orrery-theme next           cycle to the next theme
#   orrery-theme toggle         switch between the current dark and light theme
#   orrery-theme list           list available themes (* = current)
#   orrery-theme current        print the current theme name
#   orrery-theme render <name>  render only, into a temp dir (for testing)
#   orrery-theme reload         re-render the current theme and re-apply
#   orrery-theme apps           re-theme VS Code, Firefox and Chromium only (at login)
#   orrery-theme json           every theme as JSON (name, mode, colours,
#                             backgrounds) — what the shell's picker reads
#
# A theme is ~/.config/orrery/themes/<name>/colors.toml (+ backgrounds/).
# `set` renders templates/*.tpl into ~/.config/orrery/current/, then tells
# every running app to pick the new colours up. Apps import from current/;
# nothing in the repo is edited.

set -euo pipefail

HT_DIR="$HOME/.config/orrery"
THEMES_DIR="$HT_DIR/themes"
TEMPLATES_DIR="$HT_DIR/templates"
CURRENT_DIR="$HT_DIR/current"
NEXT_DIR="$HT_DIR/current.next"
RENDER="$HT_DIR/render.py"

die()  { printf 'orrery-theme: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

theme_path() {
    local name="$1"
    [[ -n "$name" && "$name" != */* && "$name" != .* ]] || die "invalid theme name '$name'"
    [[ -f "$THEMES_DIR/$name/colors.toml" ]] || die "no such theme: $name (see: orrery-theme list)"
    printf '%s' "$THEMES_DIR/$name"
}

current_name() {
    [[ -f "$CURRENT_DIR/theme.name" ]] && cat "$CURRENT_DIR/theme.name" || true
}

theme_mode() {
    # `mode = "dark"` from a colors.toml
    sed -n 's/^mode *= *"\([a-z]*\)".*/\1/p' "$1/colors.toml" | head -n1
}

list_themes() {
    local cur d
    cur="$(current_name)"
    for d in "$THEMES_DIR"/*/; do
        d="${d%/}"; [[ -f "$d/colors.toml" ]] || continue
        d="${d##*/}"
        if [[ "$d" == "$cur" ]]; then printf '* %s\n' "$d"; else printf '  %s\n' "$d"; fi
    done
}

# ---------------------------------------------------------------------------
# render <name> <out-dir>
# ---------------------------------------------------------------------------
render_into() {
    local src="$1" out="$2"
    rm -rf "$out"
    mkdir -p "$out"
    python3 "$RENDER" "$src" "$TEMPLATES_DIR" "$out" >/dev/null
    printf '%s\n' "${src##*/}" > "$out/theme.name"
    # Keep a stable path to the theme dir and its backgrounds for other tools.
    ln -nsf "$src" "$out/theme"
}

# ---------------------------------------------------------------------------
# apply — copy generated files that cannot be imported, then poke every app
# ---------------------------------------------------------------------------
install_file() {
    # install_file <generated> <destination>. Destination is always a real
    # file: if an old stow symlink is there, replace it rather than writing
    # through it into the repo.
    local src="$1" dst="$2" dir
    dir="$(dirname "$dst")"
    # A dangling directory symlink (an old stow fold of a package that no
    # longer exists) blocks mkdir -p; replace it with a real directory.
    [[ -L "$dir" && ! -e "$dir" ]] && rm -f "$dir"
    mkdir -p "$dir"
    [[ -L "$dst" ]] && rm -f "$dst"
    cp -f -- "$src" "$dst"
}

# VS Code only sees colour themes that come from an extension, so the rendered
# current/vscode-theme.json is exposed through a tiny local one and selected
# in settings.json. VS Code watches the active theme file, so re-rendering
# recolours it live; the light/dark base (uiTheme) is read on the next start.
apply_vscode() {
    local ext_base="$1" settings="$2" bin="$3" ext="$1/orrery-theme" ui
    # Only where the editor exists; VS Code creates its dir on first launch,
    # but if the binary is here we can pre-seed it so the first launch is themed.
    if [[ ! -d "$ext_base" ]]; then
        have "$bin" || return 0
        mkdir -p "$ext_base"
    fi
    have jq || return 0
    ui=$([[ "$(theme_mode "$CURRENT_DIR/theme")" == light ]] && echo vs || echo vs-dark)
    mkdir -p "$ext/themes"
    ln -sfn "$CURRENT_DIR/vscode-theme.json" "$ext/themes/orrery-theme.json"
    # second entry: the same palette mapped the way Aether does it (Ctrl+K Ctrl+T to compare)
    ln -sfn "$CURRENT_DIR/vscode-theme-aether.json" "$ext/themes/orrery-aether.json"
    cat > "$ext/package.json" <<JSON
{
    "name": "orrery-theme",
    "displayName": "Orrery",
    "description": "Colour theme generated by orrery-theme from the current rice theme",
    "publisher": "local",
    "version": "1.0.0",
    "engines": { "vscode": "^1.70.0" },
    "categories": ["Themes"],
    "contributes": { "themes": [
        { "label": "Orrery", "uiTheme": "$ui", "path": "./themes/orrery-theme.json" },
        { "label": "Orrery (Aether)", "uiTheme": "$ui", "path": "./themes/orrery-aether.json" }
    ] }
}
JSON
    # register in extensions.json (what --install-extension would write)
    local reg="$ext_base/extensions.json" tmp
    [[ -f "$reg" ]] || printf '[]\n' > "$reg"
    tmp="$(mktemp)"
    if jq --arg p "$ext" '
        map(select(.identifier.id != "local.orrery-theme")) + [{
          identifier: { id: "local.orrery-theme" }, version: "1.0.0",
          location: { "$mid": 1, fsPath: $p, external: ("file://" + $p), path: $p, scheme: "file" },
          relativeLocation: "orrery-theme" }]' "$reg" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$reg"
    else
        rm -f "$tmp"
    fi
    # settings.json is JSONC; edit in place rather than round-trip through jq.
    mkdir -p "$(dirname "$settings")"
    [[ -f "$settings" ]] || printf '{\n}\n' > "$settings"
    if ! grep -q '"workbench.colorTheme"' "$settings"; then
        sed -i -E '0,/\{/{s/\{/{\n    "workbench.colorTheme": "",/}' "$settings"
    fi
    sed -i -E 's|("workbench.colorTheme"[[:space:]]*:[[:space:]]*")[^"]*(")|\1Orrery\2|' "$settings"
}

apply_btop() {
    local conf="$1"
    mkdir -p "$(dirname "$conf")"
    if [[ ! -f "$conf" ]]; then
        cat > "$conf" <<CONF
#? Config file for btop v. 1.4 — seeded by orrery-theme; btop rewrites it on exit.
color_theme = "orrery-theme"
theme_background = False
truecolor = True
rounded_corners = True
CONF
        return 0
    fi
    if grep -q '^color_theme' "$conf"; then
        sed -i 's/^color_theme *=.*/color_theme = "orrery-theme"/' "$conf"
    else
        printf 'color_theme = "orrery-theme"\n' >> "$conf"
    fi
    # keep the terminal's translucent background rather than a solid box
    sed -i 's/^theme_background *=.*/theme_background = False/' "$conf"
}

# The editors and browsers. Run by every `set`, and at each login
# (`orrery-theme apps`, autostart.lua): an app installed or first opened after
# the theme was set gets it then, without a theme switch.
apply_apps() {
    # VS Code (Microsoft build), Code - OSS (Arch's "code") and VSCodium
    apply_vscode "$HOME/.vscode/extensions"     "$HOME/.config/Code/User/settings.json"       code     || true
    apply_vscode "$HOME/.vscode-oss/extensions" "$HOME/.config/Code - OSS/User/settings.json" code-oss || true
    [[ -d "$HOME/.config/VSCodium" ]] || have codium && \
        apply_vscode "$HOME/.vscode-oss/extensions" "$HOME/.config/VSCodium/User/settings.json" codium || true
    seed_firefox_profile || true
    apply_firefox || true
}

# root/SDDM/Chromium-policy sync (see apply); also at login, for a browser
# installed since the last theme switch
root_sync() {
    [[ -x /usr/local/bin/orrery-root-sync ]] || return 0
    sudo -n /usr/local/bin/orrery-root-sync >/dev/null 2>&1 \
        || printf 'orrery-theme: root/sddm sync skipped (run ./install.sh to set up the sudo rule)\n' >&2
}

# A Firefox that was never opened has no profile, so there is nothing to theme
# and its first window would be stock. A headless run creates the profile
# Firefox will use (bound to this install in installs.ini) in about a second.
seed_firefox_profile() {
    have firefox || return 0
    [[ -f "$HOME/.config/mozilla/firefox/profiles.ini" || -f "$HOME/.mozilla/firefox/profiles.ini" ]] && return 0
    pgrep -x firefox >/dev/null 2>&1 && return 0
    local shot; shot="$(mktemp --suffix=.png)"
    timeout 30 firefox --headless --screenshot "$shot" about:blank >/dev/null 2>&1 || true
    rm -f "$shot"
}

apply_firefox() {
    # Firefox: userChrome/userContent go into <profile>/chrome/ and the prefs
    # that enable them into <profile>/user.js (merged between markers so the
    # user's own prefs survive). Every profile listed in profiles.ini gets it;
    # Firefox 156+ keeps them under ~/.config/mozilla, older under ~/.mozilla.
    # Both files are read once at startup: restart Firefox to see a change.
    local ini base dir prof userjs
    for ini in "$HOME/.config/mozilla/firefox/profiles.ini" "$HOME/.mozilla/firefox/profiles.ini"; do
        [[ -f "$ini" ]] || continue
        base="$(dirname "$ini")"
        while IFS= read -r prof; do
            [[ "$prof" == /* ]] && dir="$prof" || dir="$base/$prof"
            [[ -d "$dir" ]] || continue
            install_file "$CURRENT_DIR/firefox-userChrome.css"  "$dir/chrome/userChrome.css"
            install_file "$CURRENT_DIR/firefox-userContent.css" "$dir/chrome/userContent.css"
            userjs="$dir/user.js"
            [[ -f "$userjs" ]] && sed -i '/^\/\/ >>> orrery/,/^\/\/ <<< orrery/d' "$userjs"
            {
                printf '// >>> orrery-theme (managed: everything to the <<< line is rewritten by orrery-theme)\n'
                cat "$CURRENT_DIR/firefox-user.js"
                printf '// <<< orrery-theme\n'
            } >> "$userjs"
        done < <(sed -n 's/^Path=//p' "$ini")
    done
}

# Papirus with its folders in another colour, for themes whose [apps]
# icon_theme is "<Papirus base>-<colour>" (Papirus-Dark-darkcyan…). Built in
# ~/.local/share/icons, no root: the theme inherits its base and holds only
# folder/user icon links re-pointed from the blue set to <colour>, which is
# what papirus-folders does system-wide.
ensure_folder_icons() {
    local name="$1" base colour src out dir sub f link target
    [[ $name =~ ^(Papirus|Papirus-Dark|Papirus-Light)-([a-z]+)$ ]] || return 0
    base="${BASH_REMATCH[1]}"; colour="${BASH_REMATCH[2]}"
    src=/usr/share/icons/Papirus
    [[ -d /usr/share/icons/$base && -e $src/48x48/places/folder-$colour.svg ]] || return 0
    out="$HOME/.local/share/icons/$name"
    [[ -f $out/index.theme && $out/index.theme -nt $src/48x48/places ]] && return 0
    rm -rf "$out"; mkdir -p "$out"
    local dirs=()
    for dir in "$src"/*/places; do
        sub="${dir#"$src"/}"; mkdir -p "$out/$sub"; dirs+=("$sub")
        for f in "$dir"/folder-blue*.svg "$dir"/user-blue*.svg; do
            [[ -e $f ]] || continue
            f="${f##*/}"; target="${f/-blue/-$colour}"; link="${f/-blue/}"
            [[ -e $dir/$target ]] && ln -sf "$src/$sub/$target" "$out/$sub/$link"
        done
        # names that reach a blue icon through a chain of links
        # (folder-publicshare -> folder-image-people -> folder-blue-image-people)
        for f in "$dir"/*.svg; do
            [[ -L $f && ! -e $out/$sub/${f##*/} ]] || continue
            target="$(readlink -f "$f")"; target="${target##*/}"
            [[ $target == folder-blue*.svg || $target == user-blue*.svg ]] || continue
            target="${target/-blue/-$colour}"
            [[ -e $dir/$target ]] && ln -s "$src/$sub/$target" "$out/$sub/${f##*/}"
        done
    done
    {
        printf '[Icon Theme]\nName=%s\nComment=%s with %s folders (orrery-theme)\nInherits=%s,hicolor\n' "$name" "$base" "$colour" "$base"
        printf 'Directories=%s\n' "$(IFS=,; echo "${dirs[*]}")"
        # each directory's own section, copied from Papirus
        for sub in "${dirs[@]}"; do
            awk -v s="[$sub]" '$0==s{p=1;print "";print;next} /^\[/{p=0} p' /usr/share/icons/Papirus/index.theme
        done
    } > "$out/index.theme"
    have gtk-update-icon-cache && gtk-update-icon-cache -q -f "$out" 2>/dev/null || true
}

# Spotify, through Spicetify, when both are there: the "orrery" theme gets the
# current colours and is (re)applied. Spotify itself is patched once
# ("spicetify backup apply"), later switches only refresh the colours; a
# running Spotify is restarted when it isn't playing. Spotify updates undo
# the patch: run "spicetify backup apply" again.
apply_spotify() {
    local sp dir
    # no Spicetify is the usual case: an empty answer, never an error (set -e)
    sp="$(command -v spicetify || { [[ -x $HOME/.spicetify/spicetify ]] && echo "$HOME/.spicetify/spicetify"; } || true)"
    [[ -n $sp ]] || return 0
    [[ -n "$("$sp" config spotify_path 2>/dev/null)" ]] || return 0
    dir="$("$sp" path userdata 2>/dev/null || true)/Themes/orrery"
    [[ $dir == /* ]] || return 0
    mkdir -p "$dir"
    install_file "$CURRENT_DIR/spicetify-color.ini" "$dir/color.ini"
    install_file "$HT_DIR/spicetify/user.css" "$dir/user.css"
    if [[ "$("$sp" config current_theme 2>/dev/null)" != orrery ]]; then
        "$sp" config current_theme orrery color_scheme orrery inject_theme_js 0 >/dev/null 2>&1
        "$sp" backup apply >/dev/null 2>&1 || "$sp" apply >/dev/null 2>&1 || true
    else
        "$sp" refresh >/dev/null 2>&1 || true
    fi
    # a running Spotify only reads its colours at start: restart it when that
    # interrupts nothing, otherwise say when the theme will show
    if pgrep -x spotify >/dev/null 2>&1; then
        if [[ "$(playerctl -p spotify status 2>/dev/null)" == Playing ]]; then
            have notify-send && notify-send -a orrery-theme "Spotify" "The new theme shows the next time Spotify starts." 2>/dev/null || true
        else
            "$sp" restart >/dev/null 2>&1 &
        fi
    fi
}

apply() {
    local mode gtk_theme icon_theme
    mode="$(theme_mode "$CURRENT_DIR/theme")"
    gtk_theme="$(sed -n 's/^gtk-theme-name=\(.*\)/\1/p' "$CURRENT_DIR/gtk3-settings.ini")"
    icon_theme="$(sed -n 's/^gtk-icon-theme-name=\(.*\)/\1/p' "$CURRENT_DIR/gtk3-settings.ini")"
    ensure_folder_icons "$icon_theme" || true

    # Files that must live at a fixed path the app owns.
    install_file "$CURRENT_DIR/gtk3-settings.ini" "$HOME/.config/gtk-3.0/settings.ini"
    install_file "$CURRENT_DIR/gtk4-settings.ini" "$HOME/.config/gtk-4.0/settings.ini"
    install_file "$CURRENT_DIR/gtkrc-2.0"          "$HOME/.gtkrc-2.0"
    install_file "$CURRENT_DIR/kde-colors"         "$HOME/.local/share/color-schemes/Orrery.colors"
    install_file "$CURRENT_DIR/kdeglobals"         "$HOME/.config/kdeglobals"
    # qt5ct/qt6ct: the colour scheme goes into their colors/ dir so the GUI
    # lists it; the .conf carries style + icon theme, which follow the mode.
    install_file "$CURRENT_DIR/qtct-colors.conf"   "$HOME/.config/qt5ct/colors/orrery-theme.conf"
    install_file "$CURRENT_DIR/qtct-colors.conf"   "$HOME/.config/qt6ct/colors/orrery-theme.conf"
    install_file "$CURRENT_DIR/qt5ct.conf"         "$HOME/.config/qt5ct/qt5ct.conf"
    install_file "$CURRENT_DIR/qt6ct.conf"         "$HOME/.config/qt6ct/qt6ct.conf"
    # btop: its theme goes into its themes/ dir and is selected in btop.conf
    # (created if btop has never been run; otherwise just the theme line).
    install_file "$CURRENT_DIR/btop.theme"         "$HOME/.config/btop/themes/orrery-theme.theme"
    install_file "$CURRENT_DIR/btop-aether.theme"  "$HOME/.config/btop/themes/orrery-aether.theme"   # Aether's mapping, for comparison
    apply_btop "$HOME/.config/btop/btop.conf"
    # Kdenlive keeps its own ColorScheme (its "Always use dark" switch writes
    # BreezeDark); point it at ours so it follows the theme like other KDE apps.
    [[ -f "$HOME/.config/kdenliverc" ]] && sed -i 's/^ColorScheme=.*/ColorScheme=Orrery/' "$HOME/.config/kdenliverc"

    # GTK4 / libadwaita apps and the portal read the colour scheme from
    # gsettings, not settings.ini. Zen/Firefox follow this too.
    if have gsettings; then
        gsettings set org.gnome.desktop.interface color-scheme \
            "$([[ "$mode" == light ]] && echo prefer-light || echo prefer-dark)" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface gtk-theme  "$gtk_theme"  2>/dev/null || true
        gsettings set org.gnome.desktop.interface icon-theme "$icon_theme" 2>/dev/null || true
    fi

    # optional apps: one that fails must never stop the wallpaper and login-screen
    # steps below (set -e is off inside a function called from ||)
    apply_spotify || true

    # Running apps: reload in place where the app supports it.
    have hyprctl       && hyprctl reload >/dev/null 2>&1 || true
    pkill -SIGUSR1 -x kitty         2>/dev/null || true   # kitty re-reads kitty.conf
    pkill -SIGUSR2 -x btop          2>/dev/null || true   # btop re-reads config + theme
    # GTK3 reads its theme once at startup and does not follow gsettings on
    # Wayland (tested: neither directly nor through the settings portal), so
    # the one GTK3 daemon we own, the polkit agent, is restarted. The shell
    # recolours itself (it watches colors.json).
    if pgrep -x polkit-gnome-au >/dev/null 2>&1; then
        pkill -x polkit-gnome-au 2>/dev/null || true
        setsid -f /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1
    fi
    # neovim: every running instance re-applies its colorscheme
    local sock
    for sock in "${XDG_RUNTIME_DIR:-/tmp}"/nvim.*.0; do
        [[ -S "$sock" ]] || continue
        nvim --server "$sock" --remote-send '<Cmd>lua pcall(function() require("config.orrery").apply() end)<CR>' >/dev/null 2>&1 || true
    done
    apply_apps
    # Chromium: the Aether/Omarchy way — Chromium's own flags set the built-in
    # theme colour and colour scheme (persisted in the profile; a running
    # instance picks it up, otherwise it applies on the next start).
    if have chromium; then
        setsid -f chromium --no-startup-window \
            --set-color-scheme="$mode" \
            --set-theme-color="$(tr -d ' ' < "$CURRENT_DIR/chromium.theme")" >/dev/null 2>&1 || true
    fi

    # quickshell (when the shell exists): it watches colors.json itself, but a
    # nudge makes the switch instant.
    have qs && qs ipc call theme reload >/dev/null 2>&1 || true

    # Wallpaper: each theme has backgrounds/; keep (or restore) one of them.
    # Sibling script by path: during install.sh ~/.local/bin may not be on PATH yet.
    local hw="${BASH_SOURCE[0]%/*}/orrery-wall"
    [[ -x "$hw" ]] || hw="$(command -v orrery-wall || true)"
    [[ -n "$hw" ]] && "$hw" ensure >/dev/null 2>&1 || true

    # root's GTK config (pkexec apps like grub-customizer) and the SDDM theme
    # need root. install.sh installs the helper + a sudoers rule for exactly
    # it; `sudo -n` never prompts, so this is silent where that is missing.
    root_sync
}

# ---------------------------------------------------------------------------
cmd_set() {
    local name="${1:-}" src
    src="$(theme_path "$name")"
    render_into "$src" "$NEXT_DIR"
    # swap in one step (the shell and apps watch current/; a delete-then-rename
    # left them a moment with no colours file); plain rename where mv can't
    if [[ -d "$CURRENT_DIR" ]] && mv --exchange -T "$NEXT_DIR" "$CURRENT_DIR" 2>/dev/null; then
        rm -rf "$NEXT_DIR"
    else
        rm -rf "$CURRENT_DIR"
        mv "$NEXT_DIR" "$CURRENT_DIR"
    fi
    apply
    [[ -z ${ORRERY_WALL_THEME:-} ]] && have notify-send && notify-send -a orrery-theme "Theme: $(sed -n 's/^name *= *"\(.*\)".*/\1/p' "$src/colors.toml")" "$(theme_mode "$src") mode" 2>/dev/null || true
    printf '%s\n' "$name"
}

cmd_next() {
    local cur names=() i n
    cur="$(current_name)"
    mapfile -t names < <(list_themes | sed 's/^[* ] //')
    n=${#names[@]}; (( n > 0 )) || die "no themes in $THEMES_DIR"
    for i in "${!names[@]}"; do
        if [[ "${names[$i]}" == "$cur" ]]; then cmd_set "${names[$(( (i + 1) % n ))]}"; return; fi
    done
    cmd_set "${names[0]}"
}

cmd_toggle() {
    # Prefer a theme whose name differs only by a -light / -dark suffix; else
    # the first theme with the opposite mode.
    local cur mode want name
    cur="$(current_name)"; [[ -n "$cur" ]] || die "no current theme"
    # the Wallpaper theme: the same picture in the other mode
    if [[ $cur == wallpaper ]]; then
        mode="$(theme_mode "$THEMES_DIR/$cur")"
        exec "${BASH_SOURCE[0]%/*}/orrery-wall-theme" apply --mode "$([[ $mode == light ]] && echo dark || echo light)" >/dev/null
    fi
    mode="$(theme_mode "$THEMES_DIR/$cur")"
    want=$([[ "$mode" == light ]] && echo dark || echo light)
    for name in "${cur%-light}" "${cur%-dark}" "${cur}-${want}" "${cur%-light}-${want}" "${cur%-dark}-${want}"; do
        [[ "$name" != "$cur" && -f "$THEMES_DIR/$name/colors.toml" ]] || continue
        [[ "$(theme_mode "$THEMES_DIR/$name")" == "$want" ]] && { cmd_set "$name"; return; }
    done
    for name in $(list_themes | sed 's/^[* ] //'); do
        [[ "$name" != "$cur" && "$(theme_mode "$THEMES_DIR/$name")" == "$want" ]] && { cmd_set "$name"; return; }
    done
    die "no $want theme to switch to"
}

cmd_json() {
    python3 - "$THEMES_DIR" "$(current_name)" <<'PY'
import json, sys, tomllib, os
root, current = sys.argv[1], sys.argv[2]
out = []
for d in sorted(os.listdir(root)):
    f = os.path.join(root, d, "colors.toml")
    if not os.path.isfile(f): continue
    with open(f, "rb") as fh: t = tomllib.load(fh)
    bg = os.path.join(root, d, "backgrounds")
    imgs = sorted(os.path.realpath(os.path.join(bg, x)) for x in os.listdir(bg)
                  if os.path.isfile(os.path.join(bg, x)) and x.lower().rsplit(".", 1)[-1] in ("png", "jpg", "jpeg", "webp")) if os.path.isdir(bg) else []
    # the Wallpaper theme: the picture it was made from first, even when it
    # lives elsewhere (a shipped theme's backgrounds), so its card shows it
    pick = os.path.expanduser("~/.local/state/orrery/background." + d)
    if d == "wallpaper" and os.path.isfile(pick):
        p = open(pick).read().strip()
        if os.path.isfile(p):
            imgs = [os.path.realpath(p)] + [i for i in imgs if i != os.path.realpath(p)]
    c = t.get("colors", {})
    # a real screenshot of the theme (orrery-theme-preview), shown by the picker
    pv = next((os.path.join(root, d, "preview." + e) for e in ("jpg", "png") if os.path.isfile(os.path.join(root, d, "preview." + e))), "")
    out.append({"id": d, "name": t.get("name", d), "mode": t.get("mode", "dark"), "bar": t.get("bar", "minimal"),
                "current": d == current, "backgrounds": imgs, "preview": os.path.realpath(pv) if pv else "",
                # changes when the preview is retaken, so the picker can cache the image
                "previewStamp": int(os.path.getmtime(pv)) if pv else 0,
                "colors": {k: c.get(k, "") for k in ("bg0", "bg1", "bg2", "bg3", "bg4", "fg", "accent_bright", "accent_light", "accent_mid", "accent_dim",
                                                    "red", "orange", "yellow", "green", "aqua", "blue", "purple")}})
print(json.dumps(out))
PY
}

case "${1:-}" in
    json)    cmd_json ;;
    set)     cmd_set "${2:-}" ;;
    next)    cmd_next ;;
    toggle)  cmd_toggle ;;
    list)    list_themes ;;
    current) current_name ;;
    apps)    [[ -f "$CURRENT_DIR/colors.json" ]] || exit 0; apply_apps; root_sync ;;
    reload)  cur="$(current_name)"; [[ -n "$cur" ]] || die "no current theme"; cmd_set "$cur" ;;
    render)  src="$(theme_path "${2:-}")"; out="$(mktemp -d)"; render_into "$src" "$out"; printf '%s\n' "$out" ;;
    *)       sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
