#!/usr/bin/env bash
# orrery-toggle gaps|opacity — flip a Hyprland look setting live. Hyprland's Lua
# config has no `keyword`; `hyprctl eval` applies a snippet, `hyprctl reload`
# puts the configured values back.
case "${1:-}" in
    gaps)
        if [[ "$(hyprctl getoption general:gaps_in -j | jq -r .css)" == "0 0 0 0" ]]; then
            hyprctl reload >/dev/null
        else
            hyprctl eval 'hl.config({ general = { gaps_in = 0, gaps_out = 0 }, decoration = { rounding = 0 } })' >/dev/null
        fi ;;
    opacity)   # fully opaque, or back to your level (Menu > Appearance > Blur & transparency)
        "${BASH_SOURCE[0]%/*}/orrery-look" opacity toggle >/dev/null ;;
    *) echo "usage: orrery-toggle gaps|opacity" >&2; exit 1 ;;
esac
