#!/usr/bin/env bash
# orrery-wall — wallpaper for Orrery.
#
#   orrery-wall set <file>   use this image (any path)
#   orrery-wall next         cycle through the current theme's backgrounds/
#   orrery-wall ensure       make sure the wallpaper is one of the theme's (theme switch)
#   orrery-wall apply        re-apply the current wallpaper (session start)
#   orrery-wall current      print the current wallpaper path
#
# The wallpaper is ~/.config/orrery/current/background, a symlink.
# Everything that shows a wallpaper reads that one path: the shell,
# hyprlock, and the SDDM greeter via
# orrery-root-sync. Themes carry
# their own backgrounds/ dir; `orrery-theme set` calls `orrery-wall next` so a
# theme switch also switches the wallpaper (Omarchy does the same).

set -euo pipefail

CURRENT_DIR="$HOME/.config/orrery/current"
LINK="$CURRENT_DIR/background"
STATE="$HOME/.local/state/orrery"

die()  { printf 'orrery-wall: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

show() {
    # The shell draws the wallpaper itself (crossfade); tell it. When it
    # isn't running it reads the link when it starts.
    [[ -e "$LINK" ]] || return 0
    local img; img="$(readlink -f "$LINK")"
    if have qs && pgrep -x qs >/dev/null 2>&1; then
        qs ipc call wallpaper set "$img" >/dev/null 2>&1 || true
    fi
}

set_wallpaper() {
    local img
    img="$(realpath -e -- "$1" 2>/dev/null)" || die "no such file: $1"
    # on the Wallpaper theme a new picture re-colours everything (it calls back
    # here with ORRERY_WALL_THEME set, to change only the picture)
    if [[ -z ${ORRERY_WALL_THEME:-} && "$(cat "$CURRENT_DIR/theme.name" 2>/dev/null)" == wallpaper ]]; then
        exec "${BASH_SOURCE[0]%/*}/orrery-wall-theme" apply "$img" >/dev/null
    fi
    mkdir -p "$CURRENT_DIR" "$STATE"
    ln -nsf "$img" "$LINK"
    # Remember the pick per theme so switching back restores it.
    local theme; theme="$(cat "$CURRENT_DIR/theme.name" 2>/dev/null || true)"
    [[ -n "$theme" ]] && printf '%s\n' "$img" > "$STATE/background.$theme"
    show
    # login screen follows (root-owned helper installed by install.sh)
    [[ -x /usr/local/bin/orrery-root-sync ]] && sudo -n /usr/local/bin/orrery-root-sync >/dev/null 2>&1 || true
}

theme_backgrounds() {
    local dir="$CURRENT_DIR/theme/backgrounds"
    [[ -d "$dir" ]] || return 0
    # canonical paths, so they compare equal to the resolved current link
    find -L "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) -print0 \
        | xargs -0 -r -n1 readlink -f | sort
}

cmd_next() {
    local list=() cur i n
    mapfile -t list < <(theme_backgrounds)
    n=${#list[@]}; (( n > 0 )) || die "current theme has no backgrounds/"
    cur="$(readlink -f "$LINK" 2>/dev/null || true)"
    for i in "${!list[@]}"; do
        if [[ "${list[$i]}" == "$cur" ]]; then set_wallpaper "${list[$(( (i + 1) % n ))]}"; return; fi
    done
    # Not one of this theme's: restore the last pick for this theme, else the first.
    local theme saved; theme="$(cat "$CURRENT_DIR/theme.name" 2>/dev/null || true)"
    saved="$(cat "$STATE/background.$theme" 2>/dev/null || true)"
    if [[ -n "$saved" && -f "$saved" ]]; then set_wallpaper "$saved"; else set_wallpaper "${list[0]}"; fi
}

cmd_ensure() {
    # Called by `orrery-theme set`: make sure the wallpaper belongs to the
    # current theme, without advancing if it already does.
    local list=() cur
    mapfile -t list < <(theme_backgrounds)
    (( ${#list[@]} > 0 )) || return 0
    cur="$(readlink -f "$LINK" 2>/dev/null || true)"
    local x; for x in "${list[@]}"; do [[ "$x" == "$cur" ]] && return 0; done
    cmd_next
}

case "${1:-}" in
    set)     set_wallpaper "${2:-}" ;;
    next)    cmd_next ;;
    ensure)  cmd_ensure ;;
    apply)   show ;;
    current) readlink -f "$LINK" 2>/dev/null || true ;;
    *)       sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
