#!/usr/bin/env bash
# orrery-agent — coding agents in the shell, the Omarchy way.
#
#   orrery-agent list               agents this machine has (with the default marked)
#   orrery-agent default [name]     show or set the default agent
#   orrery-agent launch [name]      open the agent in a terminal (default agent if no name)
#   orrery-agent usage-update       refresh ~/.local/state/orrery/agents.json (bar + panel data)
#   orrery-agent usage              print that data
#   orrery-agent skills install     link the /orrery skill into every agent's skills dir
#   orrery-agent skills status      where it is linked
#
# The default lives in ~/.config/orrery/shell.json under "agents".
set -euo pipefail

CONF="$HOME/.config/orrery/shell.json"
STATE="$HOME/.local/state/orrery/agents.json"
COLLECT="$HOME/.config/orrery/agents/usage.py"
SKILLS="$HOME/.config/orrery/skills"
# where each agent looks for skills; the generic ~/.agents one covers the rest
SKILL_DIRS=("$HOME/.claude/skills" "$HOME/.agents/skills" "$HOME/.codex/skills"
            "$HOME/.config/opencode/skills" "$HOME/.gemini/config/skills" "$HOME/.pi/agent/skills")
# command → label; anything on PATH from this list is offered
KNOWN=(claude:"Claude Code" codex:"Codex" opencode:"OpenCode" gemini:"Gemini CLI" copilot:"GitHub Copilot"
       qwen:"Qwen Code" crush:"Crush" grok:"Grok" pi:"Pi" ori:"Ori" aider:"Aider" goose:"Goose")

die() { printf 'orrery-agent: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

installed() {
    local k
    for k in "${KNOWN[@]}"; do have "${k%%:*}" && printf '%s\t%s\n' "${k%%:*}" "${k#*:}"; done
    return 0    # the last agent missing is not an error
}
get_default() {
    local d=""
    [[ -f "$CONF" ]] && have jq && d="$(jq -r '.agents.default // empty' "$CONF" 2>/dev/null || true)"
    if [[ -z "$d" ]]; then d="$(installed | head -n1 | cut -f1)"; fi
    printf '%s\n' "$d"
}
set_default() {
    have jq || die "jq is needed to edit $CONF"
    have "$1" || die "$1 is not installed"
    mkdir -p "$(dirname "$CONF")"
    [[ -f "$CONF" ]] || printf '{}\n' > "$CONF"
    local tmp; tmp="$(mktemp)"
    jq --arg a "$1" '.agents.default = $a' "$CONF" > "$tmp" && mv "$tmp" "$CONF"
    printf 'default agent: %s\n' "$1"
}

case "${1:-}" in
    list)
        d="$(get_default)"
        installed | while IFS=$'\t' read -r cmd label; do
            [[ "$cmd" == "$d" ]] && printf '* %-10s %s (default)\n' "$cmd" "$label" || printf '  %-10s %s\n' "$cmd" "$label"
        done ;;
    default)
        if [[ -n "${2:-}" ]]; then set_default "$2"; else get_default; fi ;;
    launch)
        agent="${2:-$(get_default)}"
        [[ -n "$agent" ]] || die "no coding agent installed (claude, codex, opencode, …)"
        have "$agent" || die "$agent is not installed"
        term="${TERMINAL:-$(cat "$HOME/.config/orrery/defaults/terminal" 2>/dev/null || echo kitty)}"
        case "$term" in
            kitty)     exec setsid -f kitty --class "agent-$agent" --directory "$HOME" -e "$agent" ;;
            alacritty) exec setsid -f alacritty --class "agent-$agent" --working-directory "$HOME" -e "$agent" ;;
            *)         exec setsid -f "$term" -e "$agent" ;;
        esac ;;
    usage-update)
        exec python3 "$COLLECT" "${@:2}" ;;
    usage)
        [[ -f "$STATE" ]] || python3 "$COLLECT"
        if have jq; then jq . "$STATE"; else cat "$STATE"; fi ;;
    skills)
        case "${2:-status}" in
            install)
                # one symlink per skill folder, in every agent's skills dir. Claude
                # and the generic dir always; the others only once that agent has
                # a home (so we do not litter ~ with dirs for agents never used).
                for skill in "$SKILLS"/*/; do
                    name="$(basename "$skill")"
                    for d in "${SKILL_DIRS[@]}"; do
                        case "$d" in
                            "$HOME/.claude/skills"|"$HOME/.agents/skills") ;;
                            *) [[ -d "$(dirname "$d")" ]] || continue ;;
                        esac
                        mkdir -p "$d"
                        [[ -e "$d/$name" && ! -L "$d/$name" ]] && { printf 'skip %s (not a link)\n' "$d/$name"; continue; }
                        ln -sfn "${skill%/}" "$d/$name" && printf 'linked %s -> %s\n' "$d/$name" "${skill%/}"
                    done
                done ;;
            status)
                for skill in "$SKILLS"/*/; do
                    name="$(basename "$skill")"
                    for d in "${SKILL_DIRS[@]}"; do
                        [[ -L "$d/$name" ]] && printf '%s -> %s\n' "$d/$name" "$(readlink "$d/$name")"
                    done
                done
                true ;;
            *) die "skills install|status" ;;
        esac ;;
    *)
        sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
