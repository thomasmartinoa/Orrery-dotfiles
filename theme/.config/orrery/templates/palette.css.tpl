/*
 * Orrery — shared palette (GTK CSS)          theme: {{ name }} ({{ mode }})
 * ============================================================================
 * GENERATED by orrery-theme from themes/<name>/colors.toml — do not edit.
 * Imported by GTK3, GTK4:
 *
 *     @import '../orrery/current/palette.css';
 */

/* Backgrounds — darkest to lightest */
@define-color bg0 {{ bg0 }};
@define-color bg1 {{ bg1 }};
@define-color bg2 {{ bg2 }};
@define-color bg3 {{ bg3 }};
@define-color bg4 {{ bg4 }};

/* Accents */
@define-color accent-bright {{ accent_bright }};
@define-color accent-light  {{ accent_light }};
@define-color accent-mid    {{ accent_mid }};
@define-color accent-dim    {{ accent_dim }};

/* Semantic */
@define-color active   {{ active }};
@define-color hover    {{ hover }};
@define-color warning  {{ warning }};
@define-color critical {{ critical }};
/* state colours: real hues in a hued theme, shades in a mono one */
@define-color state-good     {{ hued green accent_bright }};
@define-color state-warning  {{ hued warning accent_mid }};
@define-color state-critical {{ hued critical accent_dim }};

/* Main foreground */
@define-color fg {{ fg }};

/* Legacy names */
@define-color red    {{ red }};
@define-color orange {{ orange }};
@define-color yellow {{ yellow }};
@define-color green  {{ green }};
@define-color aqua   {{ aqua }};
@define-color blue   {{ blue }};
@define-color purple {{ purple }};

/* Borders — the rice's 1px outline: a subtle light line, stronger when focused.
   Corners go with it: 4px everywhere (Hyprland rounding = 4). */
@define-color border        {{ accent_light | rgba 0.24 }};
@define-color border-strong {{ accent_bright | rgba 0.67 }};

/* Additional greys */
@define-color grey0 {{ grey0 }};
@define-color grey1 {{ grey1 }};
@define-color grey2 {{ grey2 }};
